# Create React App environment variables (compile-time).
# Copy to `.env.local` for local development (do not commit secrets).

# Backend HTTP base URL
REACT_APP_API_URL=http://localhost:8000

# Backend websocket URL (optional; when omitted it is derived from REACT_APP_API_URL + REACT_APP_API_PREFIX)
# REACT_APP_WS_URL=ws://localhost:8000/api/v1/ws/live

# API prefix used by the backend router
REACT_APP_API_PREFIX=/api/v1

